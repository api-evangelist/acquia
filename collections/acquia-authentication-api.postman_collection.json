        {
          "name": "authorize",
          "item": [
            {
              "name": "Start the authorization_code grant",
              "id": "7967c049-4217-4e25-a865-1993e03a3805",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/oauth/authorize?response_type=code&client_id=<string>&redirect_uri=<string>&scope=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "oauth",
                    "authorize"
                  ],
                  "query": [
                    {
                      "description": "(Required) The literal value `code`.",
                      "key": "response_type",
                      "value": "code"
                    },
                    {
                      "description": "(Required) The API client's ID.",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Must match one of the client's configured Redirect URIs.",
                      "key": "redirect_uri",
                      "value": "<string>"
                    },
                    {
                      "description": "Space-separated subset of the client's selected scopes.",
                      "key": "scope",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Redirects the user to log in and grant permissions, then redirects back to `redirect_uri` with a temporary authorization code to exchange at `POST /oauth/token`. Used only by the authorization_code grant."
              },
              "response": [
                {
