    {
      "name": "oauth",
      "item": [
        {
          "name": "token",
          "item": [
            {
              "name": "Issue an access token",
              "id": "d7723cf7-bad9-400f-ba7d-acb4b0b006a0",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) ",
                      "key": "grant_type",
                      "value": "refresh_token"
                    },
                    {
                      "description": "(Required) The API client's ID (ACQUIA_CLIENT_ID).",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) The API client's secret (ACQUIA_CLIENT_SECRET).",
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "description": "Space-separated subset of the client's selected scopes. Omit to receive every selected scope. client_credentials and authorization_code only.\n",
                      "key": "scope",
                      "value": "<string>"
                    },
                    {
                      "description": "The authorization code from the redirect (authorization_code grant only).",
                      "key": "code",
                      "value": "<string>"
                    },
                    {
                      "description": "The same redirect URI used at /oauth/authorize (authorization_code grant only).",
                      "key": "redirect_uri",
                      "value": "<string>"
                    },
                    {
                      "description": "The refresh token to exchange (refresh_token grant only).",
                      "key": "refresh_token",
                      "value": "<string>"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/oauth/token",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "oauth",
                    "token"
                  ]
                },
                "description": "Issues access tokens for all three grant types. The request body is form-encoded. `client_credentials` is server-to-server; `authorization_code` exchanges a code from `GET /oauth/authorize`; `refresh_token` exchanges a refresh token. Only `authorization_code` and `refresh_token` return a `refresh_token`; `client_credentials` never does."
              },
              "response": [
                {
                  "id": "dd61930b-ab84-4267-bf10-9915cb7a9ee5",
                  "name": "A newly issued access token.",
                  "originalRequest": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/x-www-form-urlencoded"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) ",
                          "key": "grant_type",
                          "value": "refresh_token"
                        },
                        {
                          "description": "(Required) The API client's ID (ACQUIA_CLIENT_ID).",
                          "key": "client_id",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The API client's secret (ACQUIA_CLIENT_SECRET).",
                          "key": "client_secret",
                          "value": "<string>"
                        },
                        {
                          "description": "Space-separated subset of the client's selected scopes. Omit to receive every selected scope. client_credentials and authorization_code only.\n",
                          "key": "scope",
                          "value": "<string>"
                        },
                        {
                          "description": "The authorization code from the redirect (authorization_code grant only).",
                          "key": "code",
                          "value": "<string>"
                        },
                        {
                          "description": "The same redirect URI used at /oauth/authorize (authorization_code grant only).",
                          "key": "redirect_uri",
                          "value": "<string>"
                        },
                        {
                          "description": "The refresh token to exchange (refresh_token grant only).",
                          "key": "refresh_token",
                          "value": "<string>"
                        }
                      ]
                    },
                    "url": {
                      "raw": "{{baseUrl}}/oauth/token",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "oauth",
                        "token"
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
